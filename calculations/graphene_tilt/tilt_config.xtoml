# =====================================================================================
# Extended TOML (.xtoml) input for executeTB.py -- quick syntax guide
# -------------------------------------------------------------------------------------
#   key = 3.0                         plain TOML value (number, string, bool, list, ...)
#   key = [0, 0, 1]                   a list is a VALUE (e.g. a vector), NEVER a sweep
#   key = "python(-np.pi/2)"          Python expression, evaluated when the file is read.
#                                     Only numpy is available, as `np` (np.pi, np.deg2rad, ...).
#                                     It cannot use other keys of this file.
#   key = { sweep = [a, b, c] }       sweep: one calculation per value
#   key = { sweep = "python(...)" }   sweep over the values of a Python expression
#                                     (must give a non-empty 1D list/array)
#   Several sweeps must have the same length; calculation i takes value i of every sweep.
#   calculation.ID is a prefix: with a sweep, _00, _01, ... is appended automatically.
#   Keys ending in 'filename': relative to the folder of this file, absolute, or '~/...'.
#
# Run (results go next to this file, whatever the current folder; <repo> = path of the repository):
#   from this folder:
#     python <repo>/calculations/executeTB.py tilt_config.xtoml                    # generate + run
#     python <repo>/calculations/executeTB.py tilt_config.xtoml --generate-only    # only runs/*.toml
#     python <repo>/calculations/executeTB.py tilt_config.xtoml --background       # detached; log in tilt_config.out
#   or from <repo>/calculations:
#     python executeTB.py <path to this folder>/tilt_config.xtoml
# Output: runs/<crystal.name>_<ID>.toml, .log and _dipole_velocity.txt, plus
#         runs/<crystal.name>_<ID>_sweep.txt (index -> swept values) when there is a sweep.
# =====================================================================================

# Sweep over Oscar's tilts (0, 15 and 30 degrees from Gamma-K -> chi = 90, 75, 60 degrees)

[calculation]
    ID   = 'tilt'
    type = 'TBevolution_Bloch'

[crystal]
    name = 'graphene'
    W90filename = '../Wannier90 data/gr1NN_tb.dat'  # relative to the folder of this file
    threshold_hopping = 0
    a = 2.46                             # Angstrom
    dim = 2

[BZ]
    nkx = 500
    kx_min = "python(-0.75/2.46)"        # -0.75/a
    kx_max = "python( 0.75/2.46)"
    nky = 500
    ky_min = "python(-0.75/2.46)"
    ky_max = "python( 0.75/2.46)"
    nkz = 1
    kz_min = 0.0
    kz_max = 0.0

[BZ.filter]
    type = 'polygonfilter'

[BZ.filter.args]
    nsides = 6
    radius = "python(2/3/2.46)"          # |Gamma K| = 2/(3a)

[Field]
    type       = 'PulsedField'
    field_type = 'E'                     # 'E' or 'A' (optional, default 'E')
    I_W__cm2   = 5e10
    lambda     = 3000                    # nm
    varphi     = "python(-np.pi/2)"      # CEP
    chi        = { sweep = "python(np.deg2rad(np.linspace(0,30,num=5)))" }
    #chi        = "python(np.deg2rad(0))"
    ellip      = 0

[Field.env]
    type = 'env_sin2'

[Field.env.args]
    start = 0
    end   = 1
    ton   = 0.5
    toff  = 0.5

[time]
    tini = 0
    tfin = 8                             # optical periods
    nt   = 32768

[evolver]
    type = 'TBevolution_Bloch'

[evolver.calculation]
    type = 'dipole_velocity'

[evolver.calculation.args]
    nt = 512                             # time.nt / nt must be an integer
